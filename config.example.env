# Copy this file to ".env" and fill in the values you have.
# Nothing here is required to run the pipeline in --dry-run mode,
# but script generation, visuals, and upload each degrade to a
# simpler fallback (or get skipped) if their key is missing.

# Anthropic API key - used to write the facts/script for each video.
# Get one at https://console.anthropic.com/
# If omitted, the pipeline uses a small built-in fallback fact generator
# (much less varied - get a real key for real use).
ANTHROPIC_API_KEY=

# Which Claude model to use for script generation. Check
# https://docs.claude.com for the current list of model names.
ANTHROPIC_MODEL=claude-sonnet-5

# Pixabay API key (free) - used to pull stock video backgrounds.
# Get one at https://pixabay.com/api/docs/ (sign up, then your key is shown
# on that page). Tried first; Pexels below is used if this is missing/fails.
PIXABAY_API_KEY=

# Pexels API key (free) - used to pull vertical stock video backgrounds.
# Get one at https://www.pexels.com/api/
# Note: Pexels paused new key issuance in late 2026; use Pixabay instead.
# If neither key is set, the pipeline falls back to a plain animated gradient background.
PEXELS_API_KEY=

# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (YouTube Data API v3, OAuth client type "Desktop app"). See README.md for
# how to create this. Not needed if you only run with --no-upload.
YOUTUBE_CLIENT_SECRET=client_secret.json

# Where to cache the OAuth token after the first login, so you aren't
# re-prompted for every run.
YOUTUBE_TOKEN_FILE=token.json

# Default privacy status for uploaded videos: private | unlisted | public
# Start with "private" or "unlisted" until you've checked a few uploads.
YOUTUBE_PRIVACY_STATUS=private

# Default YouTube category ID. 27 = Education, 24 = Entertainment, 28 = Science & Tech.
YOUTUBE_CATEGORY_ID=27
